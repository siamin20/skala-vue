# 이 파일을 .env.local 로 복사한 뒤 본인 키를 넣는다.
# 셋 다 비워 두어도 앱은 뜬다. 목업 데이터로 물러선다.

# 기온, 습도, 바람. 키 발급: https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_KEY=

# 초단기예보(비 예보). 발급받은 키가 이미 URL 인코딩된 상태로 나오니 그대로 붙인다.
# 키 발급: https://www.data.go.kr 에서 '초단기예보조회' 신청
VITE_KMA_KEY=

# 직접 만든 KBO 백엔드(springboot-kbo-live). 없으면 목업 경기로 동작한다.
VITE_KBO_API_URL=http://localhost:8080
